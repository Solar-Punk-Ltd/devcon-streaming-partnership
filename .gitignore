node_modules/
.DS_Store
*.log
.screenshots/

# Local editor and agent preferences, not shared
.claude/settings.local.json
__pycache__/

# Terraform
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/rendered/*
!terraform/rendered/.gitkeep
terraform/**/*.tfplan
terraform/**/tfplan
# Written by the allow-me.sh in each root: an operator laptop address for one test window, never
# committed. The ** form covers both roots (git's a/**/b matches a/b too), so terraform/ and
# terraform/vultr/ are both caught by this one line.
terraform/**/operator.auto.tfvars
crash.log
crash.*.log
